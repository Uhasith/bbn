# Server Configuration
PORT=5001
NODE_ENV=production

# Database
DB_PATH=./database.sqlite

# JWT Security
JWT_SECRET=change-this-to-a-random-32-character-string

# ====================
# EMAIL CONFIGURATION
# ====================

# OPTION 1: Gmail (for testing/small scale)
# Get App Password: https://myaccount.google.com/apppasswords
# Enable 2-Factor Authentication first
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-digit-app-password

# OPTION 2: Hostinger SMTP (for production - recommended)
# Create email in Hostinger hPanel first
# Uncomment these and comment out Gmail settings above
# EMAIL_HOST=smtp.hostinger.com
# EMAIL_PORT=465
# EMAIL_USER=noreply@yourdomain.com
# EMAIL_PASS=your-email-password

# Legacy SMTP settings (if using custom SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_specific_password
# SMTP_FROM="Test Instruction Management System <your_email@gmail.com>"
