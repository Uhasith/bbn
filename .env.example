# Backend Environment Variables (.env file location: server/.env)
PORT=5001
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Gmail Option (for testing/small scale)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# OR SMTP Option (for production - recommended)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=noreplys@business-branding.nl
# MAIL_PASSWORD=your-office365-password
# MAIL_FROM_ADDRESS=noreplys@business-branding.nl
# MAIL_ENCRYPTION=tls
# MAIL_FROM_NAME=Test Instruction Management System
